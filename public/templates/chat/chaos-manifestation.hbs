<div class="chaos-manifestation-card">
	<h3>{{localize 'Genesys.ChaosManifestation.Title'}}</h3>
	<p><strong>{{localize 'Genesys.ChaosManifestation.Type'}}:</strong> {{label}}</p>
	<p><strong>{{localize 'Genesys.ChaosManifestation.UsedSymbols'}}:</strong> {{{usedSymbols}}}</p>
	<div class="chaos-manifestation-breakdown">
		<span>{{localize 'Genesys.ChaosManifestation.BaseRoll'}}</span>
		<strong>{{baseResult}}</strong>
		<span>{{localize 'Genesys.ChaosManifestation.CategoryModifier'}}</span>
		<strong>{{categoryModifier}}</strong>
		<span>{{localize 'Genesys.ChaosManifestation.EncounterModifier'}}</span>
		<strong>{{encounterModifier}}</strong>
		<span>{{localize 'Genesys.ChaosManifestation.TalentModifier'}}</span>
		<strong>{{talentModifier}}</strong>
	</div>
	<p class="chaos-manifestation-result"><strong>{{localize 'Genesys.ChaosManifestation.FinalResult'}}:</strong> {{finalResult}}</p>
	<div class="chaos-manifestation-effect">{{{effect}}}</div>
</div>
