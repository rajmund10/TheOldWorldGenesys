<div class="symbol-spending-card">
	<h3>{{localize 'Genesys.SymbolSpending.SummaryTitle'}}</h3>
	{{#if entries}}
		<ul class="symbol-spending-summary-list">
			{{#each entries}}
				<li>
					<span>{{{costHtml}}}</span>
					<span>
						<strong>{{label}}{{#if (gt uses 1)}} x{{uses}}{{/if}}</strong>
					</span>
				</li>
			{{/each}}
		</ul>
	{{else}}
		<p>{{localize 'Genesys.SymbolSpending.NoSelected'}}</p>
	{{/if}}
</div>
